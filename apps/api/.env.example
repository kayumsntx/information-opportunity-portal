# ============================================================================
# Environment Variables Example Configuration
# ============================================================================

# Application Environment (development | production)
NODE_ENV=development
PORT=3001

# Database Connection (PostgreSQL)
# Local Development: postgresql://postgres:YOUR_PASSWORD@localhost:5432/information_portal
# Render Production: Use Render's "Internal Database URL" (e.g., postgresql://user:password@dpg-xxx-a/information_portal)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/information_portal"

# Frontend URL (for CORS configuration)
# Local: http://localhost:3000
# Production (Vercel): https://your-portal.vercel.app
FRONTEND_URL="http://localhost:3000"

# Authentication & JWT Configuration
JWT_SECRET=replace_with_secure_random_secret
JWT_REFRESH_SECRET=replace_with_another_secure_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Bootstrap (Optional for seeding/bootstrap CLI)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_secure_super_admin_password

# Optional Services
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
